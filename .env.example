# Copy to .env for local development
DATABASE_URL=postgresql://user:password@localhost:5432/cibd_editor
JWT_SECRET=replace-with-a-long-random-string
NODE_ENV=development
PORT=3000

# Public base URL (used in password-reset emails)
APP_URL=https://your-app.railway.app

# SMTP for password-reset emails (optional — omit to log reset links to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your-app-password
SMTP_FROM=CBECC Editor <noreply@stok.com>
